# ─────────────────────────────────────────────────────────────────────────────
# BetterDB RAG Demo — Environment Template
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.
#
# The FastAPI app only reads OPENAI_API_KEY and REDIS_URL.
# BetterDB_* vars are for Cloud, the Docker agent, and MCP — not rag/.
# ─────────────────────────────────────────────────────────────────────────────

# ── BetterDB Cloud ────────────────────────────────────────────────────────────
# Sign in at https://<your-workspace>.app.betterdb.com (fresh login, not an old callback URL).
BETTERDB_URL=https://<your-workspace>.app.betterdb.com
BETTERDB_CLOUD_URL=wss://<your-workspace>.app.betterdb.com/agent/ws

# MCP token — dashboard Settings → MCP Tokens.
# Used by Claude Code / Cursor (@betterdb/mcp). Optional for local Monitor on :3001.
BETTERDB_TOKEN=your_mcp_token_here

# Agent token — dashboard Add Connection → Via Agent → Generate.
# Used only by `docker run betterdb/agent`. Not interchangeable with BETTERDB_TOKEN.
BETTERDB_AGENT_TOKEN=your_agent_token_here

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Redis — choose ONE option ─────────────────────────────────────────────────

# OPTION A: Upstash (cloud Redis, zero infra)
# Get password: Upstash Dashboard → your DB → TCP tab → uncheck "Read-Only Token" → copy
# Note: double-s in rediss:// enables TLS (required for Upstash)
REDIS_URL=rediss://default:your_upstash_token@your-db.upstash.io:6379

# OPTION B: Local Valkey via Docker (better for slowlog demo, 0.1ms RTT)
# Run first: docker compose up -d
# Then uncomment the line below and comment out OPTION A above
# REDIS_URL=redis://localhost:6379

# If host port 6379 is already taken, map Valkey to 6380:
# VALKEY_HOST_PORT=6380
# REDIS_URL=redis://localhost:6380

# ── RAG App — optional overrides (defaults shown) ────────────────────────────
# OPENAI_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# CACHE_THRESHOLD=0.85
# RATE_LIMIT_MINUTE=10
# RATE_LIMIT_HOUR=100
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50

# ── Upstash REST (optional, not used by RAG app — for reference only) ─────────
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_rest_token_here
